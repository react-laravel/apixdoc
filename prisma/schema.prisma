generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("user") // "admin" | "user"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations       OrganizationMember[]
  createdProjects     Project[]
  createdEndpoints    ApiEndpoint[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  teamEvents          TeamEvent[]
}

model Organization {
  teamVersion Int      @default(0)
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  projects    Project[]
  invitations OrganizationInvitation[]
  events      TeamEvent[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member") // "owner" | "admin" | "member"
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  settingsVersion        Int                       @default(1)
  publicationVersion     Int                       @default(0)
  publicationInitialized Boolean                   @default(true)
  publishedDocumentId    String?
  publicationSequence    Int                       @default(0)
  publications           PublishedDocument[]
  publicationEvents      PublicationEvent[]
  settingsRevisions      ProjectSettingsRevision[]
  layoutVersion          Int                       @default(1)
  id                     String                    @id @default(cuid())
  name                   String
  description            String                    @default("")
  isPublic               Boolean                   @default(false)
  baseUrl                String                    @default("")
  organizationId         String
  createdById            String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation(fields: [createdById], references: [id])
  folders              Folder[]
  endpoints            ApiEndpoint[]
  globalHeaders        GlobalHeader[]
  globalParams         GlobalParam[]
  environments         Environment[]
  specificationImports SpecificationImport[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  projectId String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?       @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]      @relation("FolderTree")
  endpoints ApiEndpoint[]
}

model SpecificationImport {
  active    Boolean       @default(true)
  id        String        @id @default(cuid())
  projectId String
  name      String
  format    String
  version   String
  document  String
  pointers  String        @default("[]")
  createdAt DateTime      @default(now())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoints ApiEndpoint[]

  @@index([projectId])
}

model ApiEndpoint {
  version          Int                  @default(1)
  deletedAt        DateTime?
  revisions        EndpointRevision[]
  sourceImportId   String?
  sourcePointer    String               @default("")
  sourceDefinition String               @default("{}")
  sourceBaseline   String               @default("{}")
  serverUrl        String               @default("")
  auth             String               @default("{}")
  sourceImport     SpecificationImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  id               String               @id @default(cuid())
  name             String
  method           String               @default("GET") // GET, POST, PUT, PATCH, DELETE
  path             String
  description      String               @default("")
  projectId        String
  folderId         String?
  createdById      String
  order            Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder      Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy   User               @relation(fields: [createdById], references: [id])
  parameters  EndpointParam[]
  headers     EndpointHeader[]
  requestBody RequestBody?
  responses   EndpointResponse[]

  @@index([sourceImportId])
}

model EndpointParam {
  order       Int     @default(0)
  schema      String  @default("{}")
  id          String  @id @default(cuid())
  endpointId  String
  name        String
  type        String  @default("string") // string, number, boolean, array, object
  required    Boolean @default(false)
  description String  @default("")
  example     String  @default("")
  location    String  @default("query") // query, path

  endpoint ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model EndpointHeader {
  order       Int     @default(0)
  id          String  @id @default(cuid())
  endpointId  String
  key         String
  value       String  @default("")
  description String  @default("")
  required    Boolean @default(false)

  endpoint ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model RequestBody {
  content     String @default("{}")
  id          String @id @default(cuid())
  endpointId  String @unique
  contentType String @default("application/json")
  schema      String @default("{}") // JSON schema
  example     String @default("{}") // JSON example

  endpoint ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model EndpointResponse {
  order       Int    @default(0)
  statusKey   String @default("")
  id          String @id @default(cuid())
  endpointId  String
  statusCode  Int
  description String @default("")
  contentType String @default("application/json")
  schema      String @default("{}") // JSON schema
  example     String @default("{}") // JSON example

  endpoint ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model GlobalHeader {
  id          String  @id @default(cuid())
  projectId   String
  key         String
  value       String  @default("")
  description String  @default("")
  enabled     Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GlobalParam {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  value       String  @default("")
  description String  @default("")
  location    String  @default("query") // query, header
  enabled     Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Environment {
  id        String  @id @default(cuid())
  projectId String
  name      String // "development", "staging", "production"
  baseUrl   String
  variables String  @default("{}") // JSON key-value pairs
  isDefault Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String
  tokenHash      String       @unique
  createdById    String?
  acceptedById   String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("InvitationSender", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy     User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([createdById])
}

model TeamEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  actorName      String
  action         String
  target         String
  detail         String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model EndpointRevision {
  id         String      @id @default(cuid())
  endpointId String
  version    Int
  action     String
  actorName  String
  actorId    String?
  snapshot   String
  createdAt  DateTime    @default(now())
  endpoint   ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, version])
  @@index([endpointId, createdAt])
}

model ProjectSettingsRevision {
  id        String   @id @default(cuid())
  projectId String
  version   Int
  snapshot  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model PublishedDocument {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  title       String
  note        String    @default("")
  content     String
  fingerprint String
  actorName   String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
}

model PublicationEvent {
  id            String   @id @default(cuid())
  projectId     String
  publicationId String?
  action        String
  actorName     String
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
